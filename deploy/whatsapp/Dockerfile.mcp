FROM python:3.14.6-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY whatsapp/requirements.lock /app/requirements.lock
RUN pip install -r requirements.lock
COPY src/whatsapp_assistant /app/whatsapp_assistant
USER 10001:10001
ENTRYPOINT ["python", "-m", "whatsapp_assistant.server"]
CMD ["--container-network", "--auth-config", "/run/wa/auth.json", "--bridge-token-file", "/run/wa/bridge.token"]
